# Environment variables for the Tennis Betting bot.
# Copy to secrets/.env and fill in REAL values:  cp .env.example secrets/.env
# secrets/ is gitignored — never commit it, and never paste these values into chat.

# --- Kalshi (v1) ---
KALSHI_KEY_ID=your-kalshi-key-id
KALSHI_PRIVATE_KEY_PATH=secrets/kalshi_private_key.pem

# --- Telegram alerts (v1) ---
TELEGRAM_TOKEN=your-botfather-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Dead-man's switch (optional; recommended for an unattended run) ---
# A healthchecks.io check URL, pinged ONLY AFTER each daily heartbeat DM is sent — so it measures the
# real end-to-end path and therefore catches a WEDGED long-poll (the likeliest outage: a second poller
# on the same token 409s the droplet's, and the bot goes silent while looking healthy). Set the
# check's grace to ~26h so one late beat doesn't cry wolf. Unset = no ping, and you are back to
# noticing a missing DM yourself.
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# --- Live-score feed (v2 only — not needed for v1 pre-match) ---
# LIVESCORE_API_KEY=your-api-tennis-key
